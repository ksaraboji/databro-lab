# LLM Backend Configuration
# Choose between: huggingface, openrouter, or ollama
LLM_BACKEND=huggingface

# Maximum tokens for generation (optional, default: 8192)
LLM_MAX_TOKENS=8192

# ============================================================
# Hugging Face Router Configuration
# ============================================================
# Your Hugging Face API token (required for huggingface backend)
# Get it from: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_hugging_face_api_token

# Model to use with Hugging Face Router
# Available options:
#   - google/gemma-4-31B-it
#   - google/gemma-4-26B-A4B-it
HF_MODEL_NAME=google/gemma-4-31B-it

# Hugging Face Router API endpoint (usually no change needed)
HF_BASE_URL=https://router.huggingface.co/v1

# ============================================================
# OpenRouter Configuration
# ============================================================
# Your OpenRouter API key (required for openrouter backend)
# Get it from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key

# Model to use with OpenRouter
# Available options:
#   - google/gemma-4-31b-it:free
#   - google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL_NAME=google/gemma-4-31b-it:free

# OpenRouter API endpoint (usually no change needed)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================================
# Ollama (Local) Configuration
# ============================================================
# Ollama local calls do not require an API key, but this is retained for compatibility.
OLLAMA_API_KEY=ollama

# Model to use with local Ollama
# Available options:
#   - gemma4:latest
#   - gemma4:e2b-it-q4_K_M
OLLAMA_MODEL_NAME=gemma4:latest

# Local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434
